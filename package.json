{
  "name": "azuredevops-plus-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open /demo.html",
    "build": "node scripts/build.mjs",
    "build:companion": "npm --prefix companion run build",
    "pack:companion": "npm run build && npm run build:companion && npm --prefix companion run pack:local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "dompurify": "^3.2.7",
    "marked": "^16.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.31",
    "@types/node": "^24.9.1",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.3"
  }
}
