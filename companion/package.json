{
  "name": "ado-boost-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ado-boost": "dist/cli.js"
  },
  "files": ["dist/*.js", "dist/*.exe", "dist/protocol-version.txt", "dist/Go-LICENSE.txt", "prebuilt-extension", "README.md", "LICENSE"],
  "scripts": {
